<%- include("./partials/head.ejs") %>
<body>
  <h1>Ta en pause</h1>
  <h1 id="pust">Pust</h1>
  <p>Skole kan ta mye energi, denne nettsiden er til å ta en pause og hvile hodet ditt.</p>
  <p>Kom tilbake til timen med et utvilt hodet.</p>
   <div class="music-container">
    <div class="song-info">
      <p id="artist"></p>
      <p id="title"></p>
    </div>
    <audio id="audio" src="./music/Ambient.mp3"></audio>
                 
   </div>
   <div class="progressBar">
     <input type="range" id="slider" min="0" max="100" value="0">
     <div class="timeStamp">
      <span id="currentTime">0:00</span>
      <span id="duration">0:00</span>
     </div>
   </div>
   <div class="Mnav">
     <button id="prev" class="action-btn">◁◁</button>
     <button id="play"class="action-btn main-btn">► Play</button>
     <button id="next" class="action-btn">▷▷</button>
   </div>


<div id="nav2">
